\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Architecture comparison. (a)\nobreakspace  {}Plain PPO exposes noisy (or stale, during occlusion) sensor readings as a 15-D vector directly to the policy. (b)\nobreakspace  {}Belief-augmented PPO routes each observation through a 300-particle bootstrap filter; the filter summary $(\bm  {\mu }_b, \bm  {\sigma }_b)$ augments the 18-D policy input so the agent can reason about its own localization uncertainty.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{5}{Architecture comparison. (a)~Plain PPO exposes noisy (or stale, during occlusion) sensor readings as a 15-D vector directly to the policy. (b)~Belief-augmented PPO routes each observation through a 300-particle bootstrap filter; the filter summary $(\bm {\mu }_b, \bm {\sigma }_b)$ augments the 18-D policy input so the agent can reason about its own localization uncertainty}{figure.2}{}}
\newlabel{fig:pipeline@cref}{{[figure][2][]2}{[1][3][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Belief uncertainty $\sigma _b$ (top) and distance to target (bottom) over one representative successful episode. The shaded region marks prolonged wrist-camera occlusion (steps 0--178): the particle filter's uncertainty grows steadily as no measurements arrive. Once occlusion clears, the robot approaches and the distance-dependent noise model $\sigma _{\text  {obs}}\propto d_t$ causes $\sigma _b$ to collapse from 73\,mm to $<\!10$\,mm within a few steps. The dashed line marks the successful auto-grasp at step\nobreakspace  {}188.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:belief-evo}{{3}{5}{Belief uncertainty $\sigma _b$ (top) and distance to target (bottom) over one representative successful episode. The shaded region marks prolonged wrist-camera occlusion (steps 0--178): the particle filter's uncertainty grows steadily as no measurements arrive. Once occlusion clears, the robot approaches and the distance-dependent noise model $\sigmaobs \propto d_t$ causes $\sigma _b$ to collapse from 73\,mm to $<\!10$\,mm within a few steps. The dashed line marks the successful auto-grasp at step~188}{figure.3}{}}
\newlabel{fig:belief-evo@cref}{{[figure][3][]3}{[1][4][]5}}
\newlabel{fig:reward_curve}{{4a}{5}{Subfigure 4a}{subfigure.4.1}{}}
